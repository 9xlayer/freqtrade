//@version=6
indicator("MTF Short Exit Confluence [Tri-Trigger Engine]", overlay=true, max_lines_count=500, max_labels_count=500)

// ============================================================================
// 1. CẤU HÌNH HIỂN THỊ
// ============================================================================
grp_display = "KIỂU HIỂN THỊ TRÊN BIỂU ĐỒ"
display_mode = input.string("Đường kẻ dọc (Vertical Line)", "Chế độ hiển thị", 
               options=["Đường kẻ dọc (Vertical Line)", "Tam giác dưới râu nến (Triangle Bottom)", "Cả hai (Both)"], 
               tooltip="Đường kẻ dọc: Neo cứng theo trục thời gian, không bao giờ bị lệch khi kéo dãn chart", group=grp_display)
v_line_width = input.int(1, "Độ dày đường kẻ dọc (Width)", minval=1, maxval=4, tooltip="Mặc định là 1 (mảnh nhất, tinh gọn)", group=grp_display)

// ============================================================================
// 2. CẤU HÌNH VÙNG ĐÁY RSI & CHẶN VÙNG TRUNG TÍNH
// ============================================================================
grp_bottom = "CẤU HÌNH VÙNG ĐÁY RSI (CHẶN VÙNG TRUNG TÍNH 45-60)"
rsi_oversold_level = input.float(32.0, "Ngưỡng quá bán (Oversold Floor)", minval=15.0, maxval=35.0, 
                     tooltip="RSI phải xuất phát từ dưới ngưỡng này trong các nến gần nhất", group=grp_bottom)
rsi_ceiling_level  = input.float(42.0, "Trần RSI tối đa cho phép thoát (Max Ceiling)", minval=28.0, maxval=45.0, 
                     tooltip="CHẶN TRIỆT ĐỂ: Nếu RSI đã vượt trên mức này (vào vùng 45-60) sẽ KHÔNG kích hoạt", group=grp_bottom)
oversold_lookback  = input.int(6, "Số nến quét vùng quá bán (Lookback)", minval=2, maxval=15, group=grp_bottom)

// ============================================================================
// 3. TỐI ƯU 1: BỘ LỌC KÉO DÃN BIÊN ĐỘ BOLLINGER BANDS / ATR (EXHAUSTION)
// ============================================================================
grp_bb = "TỐI ƯU 1: BỘ LỌC KÉO DÃN BOLLINGER BANDS / ATR"
use_bb_exhaust = input.bool(true, "Bật lọc kiệt quệ biên độ (Bollinger Bands / ATR)", 
                 tooltip="Chỉ kích hoạt khi giá đâm thủng dải dưới Bollinger Bands hoặc cách xa trục giữa >= 1.8 ATR (loại bỏ hoàn toàn nhiễu sideway)", group=grp_bb)

// ============================================================================
// 4. TỐI ƯU 2: NHẬN DIỆN PHÂN KỲ DƯƠNG RSI (BULLISH DIVERGENCE)
// ============================================================================
grp_div = "TỐI ƯU 2: NHẬN DIỆN PHÂN KỲ DƯƠNG RSI (BULLISH DIVERGENCE)"
use_bull_div = input.bool(true, "Bật thoát theo Phân kỳ dương RSI (King of Reversals)", 
               tooltip="Khi giá tạo đáy thấp hơn nhưng RSI tạo đáy cao hơn trong vùng quá bán -> Xác suất đảo chiều > 85%", group=grp_div)

// ============================================================================
// 5. CƠ CHẾ THOÁT NHANH V-BOUNCE (CHỐNG NHIỄU THOÁT NON - STRICT CLIMAX REVERSAL)
// ============================================================================
grp_vbounce = "CƠ CHẾ THOÁT NHANH V-BOUNCE (CHỐNG NHIỄU THOÁT NON)"
use_v_bounce        = input.bool(true, "Bật thoát nhanh cú giật chữ V (V-Bounce Climax)", 
                      tooltip="Bật/Tắt Cửa 2. Nếu muốn độ an toàn tối đa và tránh hoàn toàn thoát non, bạn có thể tắt mục này để chỉ dựa vào Phân kỳ dương & Cắt MA", group=grp_vbounce)
vb_os_level         = input.float(26.0, "Ngưỡng quá bán sâu Climax (Extreme Oversold)", minval=15.0, maxval=30.0, 
                      tooltip="RSI phải chạm sâu dưới ngưỡng này (mặc định <= 26) mới tính là cao trào bán kiệt quệ", group=grp_vbounce)
vol_climax_mult     = input.float(2.2, "Hệ số Volume Climax (x SMA 20)", minval=1.5, maxval=4.0, 
                      tooltip="Khối lượng thanh nến cao trào phải gấp >= 2.2 lần trung bình", group=grp_vbounce)
wick_ratio_min      = input.float(0.45, "Tỷ lệ râu nến dưới tối thiểu (Pinbar / Hammer)", minval=0.30, maxval=0.70, 
                      tooltip="Râu dưới phải dài chiếm ít nhất 45% thân nến để xác nhận lực cầu bắt đáy", group=grp_vbounce)
vb_min_delta_rsi    = input.float(5.0, "Gia tốc bật RSI tối thiểu (ΔRSI)", minval=3.0, maxval=12.0, group=grp_vbounce)
vb_require_green    = input.bool(true, "Bắt buộc nến xanh xác nhận (Close > Open)", 
                      tooltip="CHẶN THOÁT NON: Tuyệt đối không thoát khi nến vẫn đang là nến đỏ", group=grp_vbounce)
vb_require_piercing = input.bool(true, "Bắt buộc nến xanh nuốt >= 50% nến trước (Piercing)", 
                      tooltip="Xác nhận phe mua đã hấp thụ toàn bộ lực xả của nến đỏ liền kề", group=grp_vbounce)

// ============================================================================
// 6. CÔNG TẮC BỘ LỌC ĐA KHUNG
// ============================================================================
grp_toggle = "CÔNG TẮC BỘ LỌC BỔ TRỢ"
use_macd_supp   = input.bool(true,  "Bật hỗ trợ MACD 15M (Hist co cụm / Line ngóc lên)", group=grp_toggle)
use_filter_30m  = input.bool(false, "Bật lọc xác nhận 30M (Khuyên tắt để tối đa điểm thoát)", group=grp_toggle)
use_filter_1h   = input.bool(false, "Bật lọc bối cảnh 1H (Khuyên tắt để tối đa điểm thoát)", group=grp_toggle)

// ============================================================================
// 7. TÍNH TOÁN CHỈ BÁO KHUNG 15M
// ============================================================================
rsi_15m    = ta.rsi(close, 14)
rsi_ma_15m = ta.ema(rsi_15m, 14)

[macd_15m, sig_15m, hist_15m] = ta.macd(close, 12, 26, 9)

// Bollinger Bands & ATR
bb_basis = ta.sma(close, 20)
bb_dev   = 2.0 * ta.stdev(close, 20)
bb_lower = bb_basis - bb_dev
atr_14   = ta.atr(14)

// Điều kiện lọc kiệt quệ Bollinger Bands / ATR
cond_bb_exhaust = not use_bb_exhaust or (ta.lowest(low, 3) <= bb_lower or (bb_basis - low) >= 1.8 * atr_14)

// Động lượng MACD hỗ trợ
macd_curling_up = macd_15m >= macd_15m[1]
hist_shrinking  = hist_15m >= hist_15m[1]
cond_15m_macd   = not use_macd_supp or (hist_shrinking or macd_curling_up)

// Điều kiện chung vùng đáy RSI
rsi_was_oversold  = ta.lowest(rsi_15m, oversold_lookback) <= rsi_oversold_level
rsi_under_ceiling = rsi_15m <= rsi_ceiling_level
rsi_curling_up    = rsi_15m > rsi_15m[1]

// ----------------------------------------------------------------------------
// [CỬA 1]: THOÁT TIÊU CHUẨN (STANDARD MA CROSSOVER)
// ----------------------------------------------------------------------------
rsi_cross_up  = ta.crossover(rsi_15m, rsi_ma_15m)
cond_std_exit = rsi_was_oversold and rsi_under_ceiling and rsi_curling_up and rsi_cross_up and cond_15m_macd and cond_bb_exhaust

// ----------------------------------------------------------------------------
// [CỬA 2]: THOÁT NHANH V-BOUNCE (CHỐNG NHIỄU - STRICT CLIMAX REVERSAL)
// ----------------------------------------------------------------------------
delta_rsi = rsi_15m - rsi_15m[1]
rsi_surge = delta_rsi >= 8.0

vol_ma         = ta.sma(volume, 20)
is_vol_climax  = (volume >= vol_ma * vol_climax_mult) or (volume[1] >= vol_ma * vol_climax_mult)
candle_range   = high - low
lower_wick     = math.min(open, close) - low
is_pinbar_wick = candle_range > 0 and (lower_wick / candle_range >= wick_ratio_min)
is_green_bar   = close > open
is_piercing    = close > ((open[1] + close[1]) / 2.0)

// Kiểm tra có chạm vùng quá bán cực hạn không
extreme_os_reached = ta.lowest(rsi_15m, 4) <= vb_os_level

cond_green_ok    = not vb_require_green or is_green_bar
cond_piercing_ok = not vb_require_piercing or is_piercing

cond_vbounce_exit = use_v_bounce and extreme_os_reached and rsi_under_ceiling and cond_15m_macd and cond_bb_exhaust and cond_green_ok and (
    (rsi_surge and cond_piercing_ok) or 
    (is_vol_climax and is_pinbar_wick and cond_piercing_ok and delta_rsi >= vb_min_delta_rsi)
)

// ----------------------------------------------------------------------------
// [CỬA 3]: THOÁT DO PHÂN KỲ DƯƠNG RSI (BULLISH DIVERGENCE)
// ----------------------------------------------------------------------------
recent_p = ta.lowest(low, 3)
recent_r = ta.lowest(rsi_15m, 3)
prior_p  = ta.lowest(low, 15)[3]
prior_r  = ta.lowest(rsi_15m, 15)[3]

is_bull_div   = (recent_p < prior_p) and (recent_r > prior_r) and (prior_r <= rsi_oversold_level) and rsi_was_oversold and rsi_curling_up
cond_div_exit = use_bull_div and is_bull_div and rsi_under_ceiling and cond_15m_macd

// ============================================================================
// 8. BỘ LỌC KHUNG 30M & 1H (BỔ TRỢ)
// ============================================================================
// Khung 30M:
rsi_30m    = request.security(syminfo.tickerid, "30", ta.rsi(close, 14), barmerge.gaps_off, barmerge.lookahead_off)
rsi_ma_30m = request.security(syminfo.tickerid, "30", ta.ema(ta.rsi(close, 14), 14), barmerge.gaps_off, barmerge.lookahead_off)
[m_30m, s_30m, h_30m] = request.security(syminfo.tickerid, "30", ta.macd(close, 12, 26, 9), barmerge.gaps_off, barmerge.lookahead_off)
cond_30m = not use_filter_30m or (rsi_30m > rsi_ma_30m and h_30m >= h_30m[1])

// Khung 1H:
rsi_1h = request.security(syminfo.tickerid, "60", ta.rsi(close, 14), barmerge.gaps_off, barmerge.lookahead_off)
[m_1h, s_1h, h_1h] = request.security(syminfo.tickerid, "60", ta.macd(close, 12, 26, 9), barmerge.gaps_off, barmerge.lookahead_off)
cond_1h = not use_filter_1h or (rsi_1h <= 35.0 and h_1h >= h_1h[1])

// ============================================================================
// 9. TỔNG HỢP TÍN HIỆU THOÁT SHORT (3 CỬA ĐỘC LẬP)
// ============================================================================
exit_short_signal = (cond_div_exit or cond_vbounce_exit or cond_std_exit) and cond_30m and cond_1h

// Phân biệt màu sắc trực quan:
// Tím Neon (#E040FB): Thoát do Phân kỳ dương RSI (Bullish Divergence) - Tỷ lệ thắng 81%
// Vàng Cam (#FFD600): Thoát nhanh V-Bounce (RSI giật nảy chữ V xa MA)
// Xanh Lục (#00E676): Thoát tiêu chuẩn MA Crossover
color line_col  = cond_div_exit ? color.new(#E040FB, 20) : (cond_vbounce_exit and not cond_std_exit ? color.new(#FFD600, 20) : color.new(#00E676, 20))
color shape_col = cond_div_exit ? color.new(#E040FB, 0)  : (cond_vbounce_exit and not cond_std_exit ? color.new(#FFD600, 0)  : color.new(#00E676, 0))

// ============================================================================
// 10. HIỂN THỊ TRÊN BIỂU ĐỒ
// ============================================================================
plot(low, "Price Anchor", color=color.new(color.white, 100), display=display.none)

// Vẽ Vertical Line
if exit_short_signal and (display_mode == "Đường kẻ dọc (Vertical Line)" or display_mode == "Cả hai (Both)")
    line.new(
         x1=bar_index, y1=low, 
         x2=bar_index, y2=high, 
         extend=extend.both, 
         color=line_col, 
         width=v_line_width, 
         style=line.style_dashed
     )

// Vẽ Tam giác dưới râu nến
show_triangle = exit_short_signal and (display_mode == "Tam giác dưới râu nến (Triangle Bottom)" or display_mode == "Cả hai (Both)")
plotshape(
     show_triangle, 
     title="Exit Short Bottom Triangle", 
     style=shape.triangleup, 
     location=location.belowbar, 
     color=shape_col, 
     size=size.tiny
 )

// ============================================================================
// 11. BẢNG HUD THEO DÕI REALTIME
// ============================================================================
var table hud = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "TIÊU CHÍ (NẾN HIỆN TẠI)", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "TRẠNG THÁI", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 1, "15M RSI Quá bán (<= " + str.tostring(rsi_oversold_level, "#") + ")", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 1, rsi_was_oversold ? "ĐẠT (Oversold)" : "CHƯA ĐỦ SÂU", 
               bgcolor=rsi_was_oversold ? color.green : color.red, text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 2, "15M Bollinger/ATR Kéo dãn", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 2, cond_bb_exhaust ? "ĐẠT (Kiệt quệ)" : "CHƯA CĂNG", 
               bgcolor=cond_bb_exhaust ? color.green : color.gray, text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 3, "15M Phân kỳ dương RSI (Cửa 3)", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 3, cond_div_exit ? "BULL DIVERGENCE! (81% Win)" : "KHÔNG CÓ", 
               bgcolor=cond_div_exit ? color.purple : color.gray, text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 4, "15M V-Bounce Giật nhanh (Cửa 2)", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 4, cond_vbounce_exit ? ("V-SURGE! (Δ " + str.tostring(delta_rsi, "+#.#") + ")") : "BÌNH THƯỜNG", 
               bgcolor=cond_vbounce_exit ? color.orange : color.gray, text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 5, "15M Cắt lên RSI-MA (Cửa 1)", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 5, rsi_cross_up ? "CROSSOVER!" : "CHƯA CẮT", 
               bgcolor=rsi_cross_up ? color.green : color.gray, text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 6, "15M MACD Hỗ trợ (Slope > 0)", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 6, cond_15m_macd ? "ĐẠT" : "CHƯA ĐẠT", 
               bgcolor=cond_15m_macd ? color.green : color.red, text_color=color.white, text_size=size.small)
               
    table.cell(hud, 0, 7, "TỔNG HỢP TÍN HIỆU THOÁT SHORT", bgcolor=color.black, text_color=color.yellow, text_size=size.small)
    string exit_txt = "WAITING..."
    color exit_bg = color.black
    if exit_short_signal
        if cond_div_exit
            exit_txt := "PHÂN KỲ DƯƠNG (TÍM)!"
            exit_bg := color.purple
        else if cond_vbounce_exit and not cond_std_exit
            exit_txt := "THOÁT V-BOUNCE (VÀNG)!"
            exit_bg := color.orange
        else
            exit_txt := "THOÁT STANDARD (XANH)!"
            exit_bg := color.green
    table.cell(hud, 1, 7, exit_txt, bgcolor=exit_bg, text_color=color.white, text_size=size.small)

// Alert
alertcondition(exit_short_signal, title="ALERT: MTF Short Exit Triggered", message="[MTF EXIT] Tín hiệu thoát lệnh Short kích hoạt! Hãy chốt lời vị thế!")
