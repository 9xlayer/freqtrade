//@version=5
indicator("StrategyMTFSniper v2.6.2 - BTC/USDT Trades (2026)", overlay=true)

// Settings
show_table = input.bool(true, "Show Performance Dashboard")
show_labels = input.bool(true, "Show Entry/Exit Labels")
show_boxes = input.bool(true, "Show Trade Holding Range")

// Helper function to plot trade
f_draw_trade(id, side, open_time, open_price, close_time, close_price, profit_pct, tag, reason) =>
    is_win = profit_pct > 0
    c_box = side == "LONG" ? (is_win ? color.new(color.green, 85) : color.new(color.red, 85)) : (is_win ? color.new(color.green, 85) : color.new(color.red, 85))
    c_border = is_win ? color.green : color.red
    
    if show_boxes and time >= open_time and time <= close_time
        box.new(left=open_time, top=math.max(open_price, close_price), right=close_time, bottom=math.min(open_price, close_price), xloc=xloc.bar_time, border_color=c_border, border_width=1, bgcolor=c_box)
    
    if show_labels
        if time == open_time
            label.new(x=open_time, y=open_price, text="#" + str.tostring(id) + " " + side + "
" + str.tostring(open_price, "#.1") + "
[" + tag + "]", xloc=xloc.bar_time, yloc=side=="LONG"?yloc.belowbar:yloc.abovebar, color=side=="LONG"?color.teal:color.maroon, textcolor=color.white, style=side=="LONG"?label.style_label_up:label.style_label_down, size=size.small)
        if time == close_time
            p_str = (profit_pct > 0 ? "+" : "") + str.tostring(profit_pct, "#.2") + "%"
            label.new(x=close_time, y=close_price, text="Exit #" + str.tostring(id) + "
" + str.tostring(close_price, "#.1") + " (" + p_str + ")
" + reason, xloc=xloc.bar_time, yloc=side=="LONG"?yloc.abovebar:yloc.belowbar, color=is_win?color.green:color.red, textcolor=color.white, style=side=="LONG"?label.style_label_down:label.style_label_up, size=size.small)

// Render Trades
if barstate.islast
    f_draw_trade(1, "SHORT", 1767923100000, 90911.6, 1768179600000, 91311.5, -4.97, "short_B65plus", "trailing_stop_loss")
