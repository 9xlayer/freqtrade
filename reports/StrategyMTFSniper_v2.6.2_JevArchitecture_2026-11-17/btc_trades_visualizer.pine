//@version=5
indicator("Freqtrade BTC Trades Visualizer [MTF Sniper v2.6.2]", "FT BTC Trades v2.6.2", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// Settings
show_boxes = input.bool(true, "Hiển thị Vùng Lệnh (Boxes)")
show_lines = input.bool(true, "Hiển thị Đường nối Entry -> Exit")
show_labels = input.bool(true, "Hiển thị Nhãn Entry & Exit")
show_table = input.bool(true, "Hiển thị Bảng Thống kê Hiệu suất")

f_draw_trade(int id, string dir, int t_in, float p_in, int t_out, float p_out, float pnl, string tag, string reason) =>
    is_win = pnl > 0
    c_main = is_win ? color.green : color.red
    c_box = is_win ? color.new(color.green, 85) : color.new(color.red, 85)
    // Draw connecting line
    if show_lines
        line.new(t_in, p_in, t_out, p_out, xloc=xloc.bar_time, color=c_main, width=2, style=line.style_dashed)
    // Draw bounding box
    if show_boxes
        top = math.max(p_in, p_out)
        bot = math.min(p_in, p_out)
        box.new(t_in, top, t_out, bot, xloc=xloc.bar_time, bgcolor=c_box, border_color=c_main, border_width=1, border_style=line.style_dotted)
    // Entry label
    if show_labels
        is_short = dir == "SHORT"
        lbl_in_style = is_short ? label.style_label_down : label.style_label_up
        lbl_in_col = is_short ? color.orange : color.blue
        txt_in = "#" + str.tostring(id) + " " + dir + "\nEntry: $" + str.tostring(p_in, "#,###.1") + "\n[" + tag + "]"
        label.new(t_in, p_in, txt_in, xloc=xloc.bar_time, yloc=yloc.price, style=lbl_in_style, color=lbl_in_col, textcolor=color.white, size=size.small)
        // Exit label
        lbl_out_style = is_short ? label.style_label_up : label.style_label_down
        pnl_sign = pnl > 0 ? "+" : ""
        txt_out = "Exit #" + str.tostring(id) + "\n$" + str.tostring(p_out, "#,###.1") + " (" + pnl_sign + str.tostring(pnl, "#.##") + "%)\n" + reason
        label.new(t_out, p_out, txt_out, xloc=xloc.bar_time, yloc=yloc.price, style=lbl_out_style, color=c_main, textcolor=color.white, size=size.small)

var is_drawn = false
if barstate.islast and not is_drawn
    is_drawn := true
