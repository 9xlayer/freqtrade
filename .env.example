# =============================================================================
# JEV System-1 Configuration for Freqtrade MTF Sniper
# =============================================================================

# Operating Mode:
# - native: 100% deterministic local execution, zero API calls, 0 latency (Default proven path)
# - external: AI-assisted Hybrid Decision Score calling TypeSafe Cloud API
# - backtest: deterministic backtesting
JEV_MODE=native

# Runtime Mode:
# - deterministic: Native rules + optional local Decision gate (Default production path)
# - decision_external: Enables external Cloud AI calls (requires JEV_API_KEY)
# - pure_deterministic: Disables Decision Gate entirely
MTF_RUNTIME_MODE=deterministic

# Fail-safe Policy when External API is unreachable, times out, or fails:
# - fallback_native: Gracefully falls back to Native Quant Heuristics (RECOMMENDED)
# - reject: Vetoes the trade if AI fails
# - allow: Bypasses the AI gate (risky, not recommended)
JEV_FAIL_POLICY=fallback_native

# Hybrid Decision Composite Threshold (0.0 to 1.0):
# Composite Score = Native Score + clip(w_ai * (noul - 0.5) * 2) - choppy_penalty
# Canonical threshold is 0.70
JEV_CONFIRM_THRESHOLD=0.70

# Hybrid Score Parameters
JEV_DECISION_WEIGHT_AI=0.10
JEV_DECISION_CHOPPY_PENALTY=0.05

# TypeSafe Cloud API Settings (Required only if JEV_MODE=external)
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=your_typesafe_api_key_here
JEV_API_TIMEOUT=10
