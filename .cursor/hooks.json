{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-start.sh",
        "timeout": 20
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/after-git-commit.sh",
        "matcher": "git\\s+commit",
        "timeout": 15
      }
    ]
  }
}
