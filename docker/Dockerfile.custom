FROM freqtradeorg/freqtrade:stable

# SOCKS5 support for httpx (optional proxy on Pi / Coolify)
RUN pip install --no-cache-dir socksio

# Coolify/CI: bake strategies from git into the image so every rebuild
# picks up strategies/mtf_sniper without relying on the user_data volume.
COPY --chown=ftuser:ftuser strategies/ /freqtrade/strategies/
COPY --chown=ftuser:ftuser scripts/lint_guardrails.py /tmp/scripts/lint_guardrails.py
COPY --chown=ftuser:ftuser scripts/guardrails/ /tmp/scripts/guardrails/

# Fail image build immediately if MTF Sniper architectural guardrails fail.
ENV PYTHONPATH=/freqtrade:/tmp
WORKDIR /freqtrade
RUN python3 /tmp/scripts/lint_guardrails.py --subsystems /freqtrade/strategies/mtf_sniper \
    && rm -rf /tmp/scripts
ENV PYTHONPATH=/freqtrade

# Overlay config forces strategy_path (mounted user_data/config.json may still
# point at the removed strategies/active path).
COPY --chown=ftuser:ftuser docker/config.mtf_sniper.json /freqtrade/config.mtf_sniper.json

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=30s \
  CMD curl -fsS http://localhost:8080/api/v1/ping || exit 1

# Default CMD for Coolify Dockerfile-only deploys (compose command overrides this).
# Base image ENTRYPOINT is `freqtrade`.
CMD [ \
  "trade", \
  "--logfile", "/freqtrade/user_data/logs/freqtrade.log", \
  "--db-url", "sqlite:////freqtrade/user_data/tradesv3.sqlite", \
  "--config", "/freqtrade/user_data/config.json", \
  "--config", "/freqtrade/config.mtf_sniper.json", \
  "--strategy-path", "/freqtrade/strategies/mtf_sniper", \
  "--strategy", "StrategyMTFSniper" \
]
